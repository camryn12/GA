        },
        "id": "1729e8df",
        "outputId": "f7990d60-e0df-4ff3-a2de-6998bf3daee1"
      },
      "source": [
        "import pandas as pd\n",
        "\n",
        "# Dynamic date for \"today\" based on execution time\n",
        "today = pd.Timestamp.now(tz='UTC').normalize()\n",
        "one_week_ago = today - pd.Timedelta(days=7)\n",
        "\n",
        "# Copy dataframe and parse dates for internal filtering\n",
        "filtered_df = reports_df.copy()\n",
        "filtered_df['Parsed_Date'] = pd.to_datetime(filtered_df['Date'], errors='coerce', utc=True)\n",
        "\n",
        "# Filter for articles within the last 7 days including today\n",
        "last_7_days_df = filtered_df[\n",
        "    (filtered_df['Parsed_Date'] >= one_week_ago) &\n",
        "    (filtered_df['Parsed_Date'] <= today + pd.Timedelta(days=1))  # Includes full day of today\n",
        "]\n",
        "\n",
        "# Sort by the parsed date first\n",
        "last_7_days_df = last_7_days_df.sort_values(by='Parsed_Date', ascending=False)\n",
        "\n",
        "# Keep only the requested columns, dropping 'Parsed_Date'\n",
        "final_output_df = last_7_days_df[['Organization', 'Title', 'Link', 'Date']]\n",
        "\n",
        "display(final_output_df)\n",
        "\n",
        "# Define the CSV file path\n",
        "csv_file_path = '/content/drive/MyDrive/GA/Weekly_Reports.csv'\n",
        "\n",
        "# Prepare header metadata\n",
        "title_line = \"Economic, Financial and Strategic Publications\\n\"\n",
        "date_range_line = f\"Publications for the week of {one_week_ago.strftime('%B %d, %Y')} to {today.strftime('%B %d, %Y')}\\n\\n\"\n",
        "\n",
        "# Write metadata followed by the DataFrame CSV content\n",
        "with open(csv_file_path, 'w', encoding='utf-8') as f:\n",
        "    f.write(title_line)\n",
        "    f.write(date_range_line)\n",
        "    final_output_df.to_csv(f, index=False)\n",
        "\n",
        "print(f\"Successfully exported {len(final_output_df)} total records (including {len(sites_with_no_reports)} with no reports) to {csv_file_path} with custom headers.\")"
      ],
      "id": "1729e8df",
      "execution_count": null,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "                          Organization  \\\n",
              "57                      United Nations   \n",
              "10   Macdonald-Laurier Institute (MLI)   \n",
              "11   Macdonald-Laurier Institute (MLI)   \n",
              "12   Macdonald-Laurier Institute (MLI)   \n",
              "5                  C.D. Howe Institute   \n",
              "58                      United Nations   \n",
