    {
      "cell_type": "code",
      "source": [
        "import feedparser\n",
        "import requests\n",
        "from bs4 import BeautifulSoup\n",
        "from urllib.parse import urljoin\n",
        "import pandas as pd\n",
        "\n",
        "most_recent_reports = []\n",
        "sites_with_no_reports = []\n",
        "\n",
        "# Function to find a feed_url when not provided\n",
        "def find_rss_feeds(url):\n",
        "    \"\"\"Finds RSS or Atom feeds listed in the HTML head of a given website.\"\"\"\n",
        "    headers = {\"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\"}\n",
        "    found_feeds = []\n",
        "    try:\n",
        "        response = requests.get(url, headers=headers, timeout=10)\n",
        "        if response.status_code == 200:\n",
        "            soup = BeautifulSoup(response.text, \"html.parser\")\n",
        "            # RSS and Atom feeds are commonly advertised in <link> tags in the header\n",
        "            for link in soup.find_all(\"link\", rel=\"alternate\"):\n",
        "                href = link.get(\"href\")\n",
        "                feed_type = link.get(\"type\", \"\")\n",
        "                if href and (\"rss\" in feed_type or \"xml\" in feed_type or \"atom\" in feed_type or \"rss\" in href or \"feed\" in href):\n",
        "                    full_url = urljoin(url, href)\n",
        "                    if full_url not in found_feeds:\n",
        "                        found_feeds.append(full_url)\n",
        "    except Exception as e:\n",
        "        pass\n",
        "    return found_feeds\n",
        "\n",
        "# To try if no feed_url exists\n",
        "def parse_html_fallback(url):\n",
        "    \"\"\"Fallback layout-agnostic HTML scraper using common structural tags.\"\"\"\n",
        "    headers = {\"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\"}\n",
        "    articles = []\n",
        "    try:\n",
        "        response = requests.get(url, headers=headers, timeout=10)\n",
        "        soup = BeautifulSoup(response.text, \"html.parser\")\n",
        "        for heading in soup.find_all(['h1', 'h2', 'h3', 'h4']):\n",
        "            link_tag = heading.find('a', href=True)\n",
        "            if link_tag:\n",
        "                title = link_tag.get_text(strip=True)\n",
        "                link = urljoin(url, link_tag['href'])\n",
        "                date_str = None\n",
        "\n",
        "                parent = heading.parent\n",
        "                if parent:\n",
        "                    time_tag = parent.find(['time', 'span'], class_=lambda x: x and any(d in x.lower() for d in ['date', 'time', 'meta']))\n",
        "                    if time_tag:\n",
        "                        date_str = time_tag.get('datetime') or time_tag.get_text(strip=True)\n",
        "\n",
        "                if len(title) > 15 and link not in [a['URL'] for a in articles]:\n",
        "                    articles.append({\"Title\": title, \"URL\": link, \"Raw_Date\": date_str})\n",
        "    except Exception as e:\n",
        "        pass\n",
        "    return articles\n",
        "\n",
        "# Iterate through directory of websites and call feedparser\n",
        "for org in enhanced_directory:\n",
        "    print(f\"Processing: {org['name']}...\")\n",
        "    articles = None\n",
        "\n",
        "    # 1. If feed_url provided : Parse a remote RSS or Atom feed\n",
        "    if \"feed_url\" in org:\n",
        "        articles = feedparser.parse(org['feed_url'])\n",
        "    else:\n",
        "        print(f\"Searching for feed_urls: {org['name']}...\")\n",
        "        discovered_feeds = find_rss_feeds(org['url'])\n",
        "\n",
        "        if discovered_feeds:\n",
        "            print(f\"  Discovered: {discovered_feeds}\")\n",
        "            articles = feedparser.parse(discovered_feeds[0])\n",
        "        else:\n",
        "            print(\"  No urls discovered.\")\n",
        "            fallback_data = parse_html_fallback(org['url'])\n",
        "            if fallback_data:\n",
        "                # Standardize fallback structure to match feedparser entry-like dicts\n",
        "                articles = type('Feed', (object,), {\n",
        "                    'entries': [\n",
        "                        {\n",
        "                            'title': a['Title'],\n",
        "                            'link': a['URL'],\n",
        "                            'published': a['Raw_Date']\n",
        "                        } for a in fallback_data\n",
        "                    ],\n",
        "                    'feed': {'title': org['name']}\n",
        "                })()\n",
        "\n",
        "    # 2. Safely process and iterate through articles/entries\n",
        "    if articles is not None and hasattr(articles, 'entries') and articles.entries:\n",
        "        # Successfully parsed entries exist for this site, grab up to 5\n",
        "        for entry in articles.entries[:5]:\n",
        "            title = entry.get('title', 'No Title')\n",
        "            link = entry.get('link', 'No Link')\n",
        "            date = entry.get('published', entry.get('updated', None))\n",
        "\n",
        "            most_recent_reports.append({\n",
        "                \"Organization\": org['name'],\n",
        "                \"Title\": title,\n",
        "                \"Link\": link,\n",
        "                \"Date\": date\n",
        "            })\n",
        "            print(f\"  Found: {title} | {date}\")\n",
        "        print(\"-\" * 40)\n",
        "    else:\n",
        "        # Strictly tracks organizations that returned zero entries/failed to parse entirely\n",
        "        print(\"Failed to parse or find any articles for this organization.\\n\")\n",
        "        sites_with_no_reports.append(org['name'])\n",
        "\n",
        "print(\"\\n--- Completed Processing ---\")\n",
        "reports_df = pd.DataFrame(most_recent_reports)\n",
        "print(f\"Unparseable sites ({len(sites_with_no_reports)}): {sites_with_no_reports}\")"
      ],
      "metadata": {
