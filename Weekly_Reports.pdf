      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "7323b60f",
        "outputId": "3ac567d2-3384-4ce1-8e1d-7ff6908fe372"
      },
      "source": [
        "!pip install -q reportlab\n",
        "\n",
        "import os\n",
        "import pandas as pd\n",
        "from reportlab.lib.pagesizes import letter\n",
        "from reportlab.lib import colors\n",
        "from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle, KeepTogether\n",
        "from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle\n",
        "\n",
        "# --- 0. Safeguard: Restore Dataframes if Session State was Lost ---\n",
        "if 'reports_df' not in globals():\n",
        "    csv_file_path = '/content/drive/MyDrive/GA/Weekly_Reports.csv'\n",
        "    if os.path.exists(csv_file_path):\n",
        "        # Read the csv, skipping the custom title and metadata headers on lines 0 and 1\n",
        "        reports_df = pd.read_csv(csv_file_path, skiprows=3, names=['Organization', 'Title', 'Link', 'Date'])\n",
        "    else:\n",
        "        raise FileNotFoundError(\"The dataset CSV file was not found. Please re-run the scraping step first.\")\n",
        "\n",
        "if 'sites_with_no_reports' not in globals():\n",
        "    sites_with_no_reports = []\n",
        "\n",
        "# --- 1. Filter and Prepare Data ---\n",
        "today = pd.Timestamp.now(tz='UTC').normalize()\n",
        "one_week_ago = today - pd.Timedelta(days=7)\n",
        "\n",
        "filtered_df = reports_df.copy()\n",
        "filtered_df['Parsed_Date'] = pd.to_datetime(filtered_df['Date'], errors='coerce', utc=True)\n",
        "\n",
        "last_7_days_df = filtered_df[\n",
        "    (filtered_df['Parsed_Date'] >= one_week_ago) &\n",
        "    (filtered_df['Parsed_Date'] <= today + pd.Timedelta(days=1))\n",
        "]\n",
        "last_7_days_df = last_7_days_df.sort_values(by='Parsed_Date', ascending=False)\n",
        "final_output_df = last_7_days_df[['Organization', 'Title', 'Link', 'Date']].copy()\n",
        "\n",
        "# Define a helper function to construct a summarization sentence for each article\n",
        "def summarize_article(row):\n",
        "    org = row['Organization']\n",
        "    title = row['Title']\n",
        "    return f\"This article from {org} details: '{title}'\"\n",
        "\n",
        "# --- 2. Setup PDF Document ---\n",
        "pdf_path = '/content/drive/MyDrive/GA/Weekly_Reports.pdf'\n",
        "os.makedirs(os.path.dirname(pdf_path), exist_ok=True)\n",
        "doc = SimpleDocTemplate(pdf_path, pagesize=letter, leftMargin=30, rightMargin=30, topMargin=40, bottomMargin=40)\n",
        "story = []\n",
        "\n",
        "# --- 3. Styles ---\n",
        "styles = getSampleStyleSheet()\n",
        "title_style = ParagraphStyle(\n",
        "    'ReportTitle',\n",
        "    parent=styles['Heading1'],\n",
        "    fontName='Helvetica-Bold',\n",
        "    fontSize=18,\n",
        "    leading=22,\n",
        "    textColor=colors.HexColor('#1A365D'),\n",
        "    spaceAfter=6\n",
        ")\n",
        "subtitle_style = ParagraphStyle(\n",
        "    'ReportSubtitle',\n",
        "    parent=styles['Normal'],\n",
        "    fontName='Helvetica-Oblique',\n",
        "    fontSize=10,\n",
        "    leading=14,\n",
        "    textColor=colors.HexColor('#4A5568'),\n",
        "    spaceAfter=20\n",
        ")\n",
        "h2_style = ParagraphStyle(\n",
        "    'SectionHeading',\n",
        "    parent=styles['Heading2'],\n",
        "    fontName='Helvetica-Bold',\n",
        "    fontSize=13,\n",
        "    leading=16,\n",
        "    textColor=colors.HexColor('#2B6CB0'),\n",
        "    spaceBefore=15,\n",
        "    spaceAfter=10\n",
        ")\n",
        "cell_text_style = ParagraphStyle(\n",
        "    'CellText',\n",
        "    parent=styles['Normal'],\n",
        "    fontName='Helvetica',\n",
        "    fontSize=8,\n",
        "    leading=11\n",
        ")\n",
        "summary_text_style = ParagraphStyle(\n",
        "    'SummaryText',\n",
        "    parent=styles['Normal'],\n",
        "    fontName='Helvetica-Oblique',\n",
        "    fontSize=7.5,\n",
        "    leading=10,\n",
        "    textColor=colors.HexColor('#2D3748')\n",
        ")\n",
        "link_text_style = ParagraphStyle(\n",
        "    'LinkText',\n",
        "    parent=cell_text_style,\n",
        "    textColor=colors.HexColor('#3182CE')\n",
        ")\n",
        "list_item_style = ParagraphStyle(\n",
        "    'ListItem',\n",
        "    parent=styles['Normal'],\n",
        "    fontName='Helvetica',\n",
        "    fontSize=9,\n",
        "    leading=12,\n",
        "    leftIndent=15,\n",
        "    firstLineIndent=-10,\n",
        "    spaceAfter=4\n",
        ")\n",
        "\n",
        "# --- 4. Write Header Section ---\n",
        "story.append(Paragraph(\"Economic, Financial and Strategic Publications\", title_style))\n",
        "story.append(Paragraph(f\"Publications for the week of {one_week_ago.strftime('%B %d, %Y')} to {today.strftime('%B %d, %Y')}\", subtitle_style))\n",
        "\n",
        "# --- 5. Generate Styled Table of Reports ---\n",
        "if not final_output_df.empty:\n",
        "    story.append(Paragraph(\"Active Publications Found\", h2_style))\n",
        "\n",
        "    # Table setup (Col Widths total 552 to match wider page margins printable area width)\n",
        "    col_widths = [100, 180, 140, 72, 60]\n",
        "    table_data = [[Paragraph(\"<b>Organization</b>\", cell_text_style),\n",
        "                   Paragraph(\"<b>Title & Summary</b>\", cell_text_style),\n",
        "                   Paragraph(\"<b>Link</b>\", cell_text_style),\n",
        "                   Paragraph(\"<b>Date</b>\", cell_text_style),\n",
        "                   Paragraph(\"<b>Status</b>\", cell_text_style)]]\n",
        "\n",
        "    for _, row in final_output_df.iterrows():\n",
        "        clean_date = \"\" if pd.isna(row['Date']) else str(row['Date']).split(\" \")[0:4]\n",
        "        clean_date = \" \".join(clean_date) if isinstance(clean_date, list) else str(row['Date'])\n",
        "\n",
        "        # Create clickable link anchor\n",
        "        link_html = f'<a href=\"{row[\"Link\"]}\" color=\"#3182CE\"><u>{row[\"Link\"][:35]}...</u></a>'\n",
        "\n",
        "        # Generate sentence summary\n",
        "        summary_sentence = summarize_article(row)\n",
        "\n",
        "        # Construct composite cell of Title + Summary Sentence block\n",
        "        title_and_summary = [\n",
        "            Paragraph(f\"<b>{row['Title']}</b>\", cell_text_style),\n",
        "            Spacer(1, 3),\n",
        "            Paragraph(summary_sentence, summary_text_style)\n",
        "        ]\n",
        "\n",
        "        table_data.append([\n",
        "            Paragraph(str(row['Organization']), cell_text_style),\n",
        "            title_and_summary,\n",
        "            Paragraph(link_html, link_text_style),\n",
        "            Paragraph(clean_date, cell_text_style),\n",
        "            Paragraph(\"Active\", cell_text_style)\n",
        "        ])\n",
        "\n",
        "    report_table = Table(table_data, colWidths=col_widths, repeatRows=1)\n",
        "    report_table.setStyle(TableStyle([\n",
        "        ('BACKGROUND', (0,0), (-1,0), colors.HexColor('#F7FAFC')),\n",
        "        ('BOTTOMPADDING', (0,0), (-1,0), 6),\n",
        "        ('ALIGN', (0,0), (-1,-1), 'LEFT'),\n",
        "        ('VALIGN', (0,0), (-1,-1), 'TOP'),\n",
        "        ('GRID', (0,0), (-1,-1), 0.5, colors.HexColor('#E2E8F0')),\n",
        "        ('TOPPADDING', (0,1), (-1,-1), 6),\n",
        "        ('BOTTOMPADDING', (0,1), (-1,-1), 6),\n",
        "    ]))\n",
        "    story.append(report_table)\n",
        "else:\n",
        "    story.append(Paragraph(\"No active publications were released during this 7-day window.\", cell_text_style))\n",
        "\n",
        "# --- 6. Append Inactive Organizations ---\n",
        "story.append(Spacer(1, 20))\n",
        "\n",
        "no_reports_story = []\n",
        "no_reports_story.append(Paragraph(\"Organizations with No New Publications This Week\", h2_style))\n",
        "for idx, site in enumerate(sorted(sites_with_no_reports), 1):\n",
        "    no_reports_story.append(Paragraph(f\"• {site}\", list_item_style))\n",
        "\n",
        "# Keep the inactive section grouped together structurally so it doesn't break poorly across pages\n",
        "story.append(KeepTogether(no_reports_story))\n",
        "\n",
        "# Build PDF document\n",
        "doc.build(story)\n",
        "print(f\"Successfully generated highly formatted PDF report at: {pdf_path}\")"
      ],
      "id": "7323b60f",
      "execution_count": 10,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Successfully generated highly formatted PDF report at: /content/drive/MyDrive/GA/Weekly_Reports.pdf\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "To .CSV"
      ],
